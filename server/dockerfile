# ---------- builder ----------
FROM rust:1.92 AS builder
WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY migrations ./migrations
COPY src ./src

# Registry and target are cache mounts, so only changed crates recompile;
# the binary has to be copied out of the target mount
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --release && cp target/release/server /app/server-bin

# ---------- runtime ----------
# distroless/cc ships glibc, libgcc and CA certs (needed for TMDB over TLS); no shell.
FROM gcr.io/distroless/cc-debian13
WORKDIR /app

COPY --from=builder /app/server-bin /app/server

ENV API_PORT=3000
EXPOSE 3000
CMD ["./server"]
